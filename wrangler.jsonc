{
  "name": "ronda-editorial-webapp",
  "main": "src/index.js",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTELLIGENT_JOBS_QUEUE",
        "queue": "ronda-editorial-intelligent-jobs"
      },
      {
        "binding": "ROUND_JOBS_QUEUE",
        "queue": "ronda-editorial-round-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "ronda-editorial-intelligent-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 15,
        "dead_letter_queue": "ronda-editorial-intelligent-jobs-dlq",
        "max_concurrency": 2
      },
      {
        "queue": "ronda-editorial-round-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 20,
        "dead_letter_queue": "ronda-editorial-round-jobs-dlq",
        "max_concurrency": 1
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "minify": true,
  "keep_names": false
}
