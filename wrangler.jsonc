{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ronda-editorial-webapp",
  "main": "src/index.js",
  "compatibility_date": "2026-07-22",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INTELLIGENT_JOBS_QUEUE",
        "queue": "ronda-editorial-intelligent-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "ronda-editorial-intelligent-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 5
      }
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
